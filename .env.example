# Copy this file to .env and fill it in. Never commit .env.
# ---------------------------------------------------------

# Discord bot token — Developer Portal → your app → Bot → Reset Token
DISCORD_TOKEN=

# The GitHub repo the dashboard edits and the bot polls  (owner/name)
GITHUB_REPO=
GITHUB_BRANCH=main
# config file path inside the repo (default config.json)
GITHUB_FILE=config.json
# state file the BOT writes back for the dashboard's channel/role dropdowns
# (needs the token below; without it the dashboard falls back to ID paste boxes)
GITHUB_STATE_FILE=state.json

# Optional: fine-grained PAT for the BOT to write state.json.
# Scope: this repo only, Contents: read and write. The dashboard does NOT
# need this — it asks for its own token in the browser.
GITHUB_TOKEN=

# How often config.json is rechecked, seconds (default 20)
POLL_SECONDS=20